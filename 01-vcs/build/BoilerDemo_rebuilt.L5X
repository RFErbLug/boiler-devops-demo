      <Tag Name="TestIncrementTag" Class="Standard" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
        <Data Format="L5K"><![CDATA[91]]></Data>
        <Data Format="Decorated">
