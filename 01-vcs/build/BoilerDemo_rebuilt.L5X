              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Tank2_ValveOutCmd)GE(Tank2_Level,1)OTE(Tank2_ValveOutStatus);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Tank2_ValveInStatus)ADD(Tank2_Level,1,Tank2_Level);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[XIC(Tank2_ValveOutStatus)SUB(Tank2_Level,1,Tank2_Level);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
