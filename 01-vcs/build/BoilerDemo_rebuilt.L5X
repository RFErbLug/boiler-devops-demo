        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[SWPB(V1,WORD,tmp)CLR(V1_Hi)MVM(tmp,65535,V1_Hi);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[CLR(V1_Lo)MVM(V1,65535,V1_Lo);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[SWPB(V2,WORD,tmp)CLR(V2_Hi)MVM(tmp,65535,V2_Hi);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[CLR(V2_Lo)MVM(V2,65535,V2_Lo);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text><![CDATA[ADD(V1_Lo,V2_Lo,SumLo)ADD(V1_Hi,V2_Hi,SumHi);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text><![CDATA[XIC(SumLo.16)ADD(SumHi,1,SumHi);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text><![CDATA[CLR(tmp)MVM(SumHi,65535,tmp)SWPB(SumHi,WORD,Out)MVM(SumLo,65535,Out);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text><![CDATA[XIC(SumHi.16)OTE(Sts_C);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text><![CDATA[XIC(Out.31)OTE(Sts_N);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text><![CDATA[[XIC(Sts_N) ,XIC(Sts_C) ]OTE(Sts_V);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text><![CDATA[XIO(Sts_C)EQ(Out,0)OTE(Sts_Z);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
