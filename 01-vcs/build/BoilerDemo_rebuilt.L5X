      <AddOnInstructionDefinition Name="UADD" Class="Standard" Revision="1.1" Vendor="Dr. Frank Jordan / Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-06-10T14:08:02.386Z" CreatedBy="WIN-FJASSBQU6AJ\RA" EditedDate="2014-08-28T13:40:19.196Z" EditedBy="RA-INT\RdeRijke" SoftwareRevision="v21.03">
