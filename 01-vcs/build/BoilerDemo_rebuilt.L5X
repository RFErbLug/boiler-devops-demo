          <LocalTag Name="WRK" DataType="INT" Dimensions="6" Radix="Decimal" ExternalAccess="None">
            <DefaultData Format="L5K"><![CDATA[[0,0,0,0,0,0]]]></DefaultData>
            <DefaultData Format="Decorated">
              <Array DataType="INT" Dimensions="6" Radix="Decimal">
                <Element Index="[0]" Value="0" />
                <Element Index="[1]" Value="0" />
                <Element Index="[2]" Value="0" />
                <Element Index="[3]" Value="0" />
                <Element Index="[4]" Value="0" />
                <Element Index="[5]" Value="0" />
              </Array>
            </DefaultData>
          </LocalTag>
          <LocalTag Name="WRKm" DataType="DINT" Dimensions="6" Radix="Decimal" ExternalAccess="None">
            <DefaultData Format="L5K"><![CDATA[[0,0,0,0,0,0]]]></DefaultData>
            <DefaultData Format="Decorated">
              <Array DataType="DINT" Dimensions="6" Radix="Decimal">
                <Element Index="[0]" Value="0" />
                <Element Index="[1]" Value="0" />
                <Element Index="[2]" Value="0" />
                <Element Index="[3]" Value="0" />
                <Element Index="[4]" Value="0" />
                <Element Index="[5]" Value="0" />
              </Array>
            </DefaultData>
          </LocalTag>
          <LocalTag Name="Low" DataType="DINT" Radix="Decimal" ExternalAccess="None">
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </LocalTag>
          <LocalTag Name="Mid" DataType="DINT" Radix="Decimal" ExternalAccess="None">
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </LocalTag>
          <LocalTag Name="High" DataType="DINT" Radix="Decimal" ExternalAccess="None">
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
