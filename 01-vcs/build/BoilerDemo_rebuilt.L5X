        <Routines>
          <Routine Name="Alarms" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Lines 115 - 121 of C#]]></Comment>
                <Text><![CDATA[GT(UseMinute,SET_FilterLimit)OTE(FilterAlarm);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(zCTRL_Alarms.F.0)OTE(TemperatureAlarm);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(zCTRL_Alarms.F.1)OTE(FanAlarm);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[XIC(zCTRL_Alarms.F.2)OTE(DoorAlarm);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[START the oven

Lines 123 - 133 of C# [ the "entry" condition = private void StartStop_VariableChange( ... ]
Lines 152 - 165 [ ResetOven() ]
Lines 298 - 311 [ StartOven() ]]]></Comment>
                <Text><![CDATA[XIO(Running)XIC(StartStop)[CLR(ActualDuration_F[1]) CLR(ActualDuration_F[2]) CLR(ActualDuration_F[3]) CLR(ActualDuration) ,CLR(SpeedFanInput) CLR(SpeedFanOutput) CLR(WRK_TimeToFinishAll) ,CLR(Gas) CLR(kWh) ,GSV(WallClockTime,,DateTime,JobStart.Year) MOVE(RecipeName,JobRecipe) ,ADD(WRK_TimeToFinishAll,SET_Duration_F[1],WRK_TimeToFinishAll) ADD(WRK_TimeToFinishAll,SET_Duration_F[2],WRK_TimeToFinishAll) ADD(WRK_TimeToFinishAll,SET_Duration_F[3],WRK_TimeToFinishAll) ,MOVE(1,ActualPhase) OTL(zCTRL_SetPointPhase) OTL(zCTRL_FirstRunBit) ,OTL(Running) ];]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[STOP the oven

Lines 123 - 133 of C# [ the "entry" condition = private void StartStop_VariableChange( ... ]
Lines 139 - 150 of C# [ private void StopOven() ]]]></Comment>
                <Text><![CDATA[XIC(Running)[XIO(StartStop) ,XIC(zCTRL_Finished_STOP) ][CLR(ActualPhase) CLR(SpeedFanInput) CLR(SpeedFanOutput) ,CPT(kWh,kWh + (kWh * SET_Duration_F[3]) / 3600) ,MOVE(Gas,JobGas) MOVE(kWh,JobkWh) ,OTU(Running) ,OTU(StartStop) ,OTU(zCTRL_Finished_STOP) ];]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Running)JSR(OvenLogic,0);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Generates a random number every 1.5 seconds
If the random number is between 0.0 and 0.05, then the interval is "split" in three ( Cfg_NumberOfFaults ) and one of the three outputs is set.
Reset back to zero after a time between 1 and 5 seconds ( Cfg_FaultDurationMin, Cfg_FaultDurationMax )]]></Comment>
                <Text><![CDATA[AOI_FaultGen(zCTRL_Alarms);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text><![CDATA[XIC(Running)JSR(Alarms,0);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Execute "Oven Temperature Simulation" every 250 ms

Lines 111 - 112 of C#]]></Comment>
                <Text><![CDATA[[MOVE(250,zCTRL_Timer.PRE) ,XIO(zCTRL_Timer.DN) TON(zCTRL_Timer,?,?) ,XIC(zCTRL_Timer.DN) JSR(OvenTemperature,0) ];]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Reset the filter use timer

Lines 391- 395 of C#   [  public void ResetFilter()  ]]]></Comment>
                <Text><![CDATA[XIC(ResetFilter)[CLR(WRK_useMinute) CLR(UseMinute) ,OTU(ResetFilter) ];]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="OvenLogic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Switch to next phase

Lines 167 - 206 of C# [ part of private void SetPointPhase(int phase) ]]]></Comment>
                <Text><![CDATA[XIC(zCTRL_SetPointPhase)LT(ActualPhase,4)[MOVE(SET_SpeedFanInput_F[ActualPhase],SpeedFanInput) MOVE(SET_SpeedFanOutput_F[ActualPhase],SpeedFanOutput) ,MOVE(SET_Duration_F[ActualPhase],WRK_TimeToFinishPhase) MOVE(SET_TemperatureSetpoint_F[ActualPhase],ActualSetpoint) ,GT(ActualPhase,1) CPT(kWh,kWh + (kW * SET_Duration_F[ActualPhase-1]) / 3600) ,CPT(kW,3 * (SpeedFanInput / 100) + 3 * (SpeedFanOutput / 100)) ,OTU(zCTRL_SetPointPhase) ];]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Get a timestamp (to record duration of scan for "timing")]]></Comment>
                <Text><![CDATA[[GSV(CST,,CurrentValue,WRK_interval_CSTactual[0]) ,XIC(zCTRL_FirstRunBit) COP(WRK_interval_CSTactual[0],WRK_interval_CSTprevious[0],1) OTU(zCTRL_FirstRunBit) ,SUB(WRK_interval_CSTactual[0],WRK_interval_CSTprevious[0],WRK_interval) ];]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Calculate the times

Wehn the time of the phase is done -> switch to another phase

Lines 230 - 246 of C# [ OvenLogic() ]
Lines 279 - 292 of C#  [ OvenLogic() ]]]></Comment>
                <Text><![CDATA[[[CPT(WRK_TimeToFinishPhase,WRK_TimeToFinishPhase - (WRK_interval / 1000000)) CPT(WRK_TimeToFinishAll,WRK_TimeToFinishAll - (WRK_interval / 1000000)) ,MOVE(WRK_TimeToFinishPhase,TimeToFinishPhase) MOVE(WRK_TimeToFinishAll,TimeToFinishAll) CPT(ActualDuration,SET_Duration_F[1] + SET_Duration_F[2] + SET_Duration_F[3] - WRK_TimeToFinishAll) ] ,LE(WRK_TimeToFinishPhase,0) [MOVE(SET_Duration_F[ActualPhase],ActualDuration_F[ActualPhase]) ,ADD(ActualPhase,1,ActualPhase) OTL(zCTRL_SetPointPhase) ] ,GT(WRK_TimeToFinishPhase,0) SUB(SET_Duration_F[ActualPhase],TimeToFinishPhase,ActualDuration_F[ActualPhase]) ];]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[COP(WRK_interval_CSTactual[0],WRK_interval_CSTprevious[0],1);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Filter use timer

Lines 274, 275 of C#  [ OvenLogic() ]]]></Comment>
                <Text><![CDATA[LT(UseMinute,SET_FilterLimit)ADD(WRK_useMinute,WRK_interval,WRK_useMinute)DIV(WRK_useMinute,1000000,UseMinute);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[End the sequence (after the last phase is ended)

Lines 212 - 217 and 221 of C# [ part of private void SetPointPhase(int phase) ]]]></Comment>
                <Text><![CDATA[XIC(zCTRL_SetPointPhase)GE(ActualPhase,4)[ADD(CycleNumber,1,CycleNumber) ,GSV(WallClockTime,,DateTime,JobFinish.Year) ,OTU(zCTRL_SetPointPhase) ,OTL(zCTRL_Finished_STOP) ];]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="OvenTemperature" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Lines 356, 317 and 337 of C#]]></Comment>
                <Text><![CDATA[[XIO(Running) XIO(Preheating) CLR(WRK_TemperatureSetpoint) ,XIC(Running) MOVE(ActualSetpoint,WRK_TemperatureSetpoint) ,XIC(Preheating) MOVE(SET_PreheatingTemperature,WRK_TemperatureSetpoint) ];]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA["Throttle logic"

Lines 317-18, 321-326, 337-345 of C#   [ UpdateOvenTemperature() ]]]></Comment>
                <Text><![CDATA[[CPT(WRK_throttle,10 - (1 - (WRK_TemperatureSetpoint - ActualTemperature) / 40) * 10) ,GE(ActualTemperature,WRK_TemperatureSetpoint) CLR(WRK_throttle) ,CMP(WRK_TemperatureSetpoint - ActualTemperature > 40) MOVE(10,WRK_throttle) ];]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Temperature "Simulation"

Lines 328-336, 347-366 of C#  [ UpdateOvenTemperature() ]]]></Comment>
                <Text><![CDATA[NE(ActualTemperature,WRK_TemperatureSetpoint)CPT(ActualTemperature,ActualTemperature + (WRK_TemperatureSetpoint - ActualTemperature) * 0.1);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[MOVE(WRK_throttle,GasThrottle);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Gas and electricity consumption

Lines 319, 370-376, 385-389 of C#]]></Comment>
                <Text><![CDATA[XIC(Running)[CPT(WRK_kWh_change,(kW * zCTRL_Timer.PRE/1000) / 3600) ADD(kWh,WRK_kWh_change,kWh) ADD(TotEE,WRK_kWh_change,TotEE) ,CPT(WRK_Gas_change,((GasThrottle * zCTRL_Timer.PRE/1000) / 3600) / 4) ADD(Gas,WRK_Gas_change,Gas) ADD(TotLPG,WRK_Gas_change,TotLPG) ];]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
