      <AddOnInstructionDefinition Name="AOI_FaultGen" Class="Standard" Revision="1.2" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2022-05-26T08:55:10.112Z" CreatedBy="RAW10-PZA01-VMG\pzaruba" EditedDate="2022-07-30T09:28:49.919Z" EditedBy="RAW10-PZA01-VMG\pzaruba" SoftwareRevision="v33.01">
        <Description><![CDATA[Using random numbers [AOI_SIM_RNG_Simple] to generate 1-64 faults and their duration]]></Description>
        <RevisionNote><![CDATA[Cfg_CycleTime changed to local tag (no need to have many configuration tags exposed)]]></RevisionNote>
        <AdditionalHelpText><![CDATA[This AOI uses Random Number ganerator to create up to 64 different outputus (BOOLs), each with different duration.

( Cfg_FaultOccurencesAll ) affects "probability" of TRUE value of all outputs ( F.x )
( Cfg_FaultOccurences[x] ) can be used to set the ratio among "probabilities" of individual outputs ( F.x ) getting true -> higher value, haigher probability

Mechanism:
- Value of the random number is between 0 and 1
- Random number is generated every ( Cfg_CycleTime ) seconds
- Value of Random numebr is checked, whether it falls in interval [0 - Cfg_FaultOccurenceAll]
- If Random number is in the configured interval, then this interval is split into pieces:
   where number of pieces to "split the interval into" is:
   SUM of ( Cfg_FaultOccurences[] ) ... the count of Cfg_FaultOccurences members to use is ( Cfg_NumberOfFaults )
- Each "output" (F.x) then has its "own" interval of the [0 - Cfg_FaultOccurenceAll]. If the Random number falls into the interval related to F.x, then F.x is set high
- Reset of F.x to low is after a random time between ( Cfg_FaultDurationMin ) and ( Cfg_FaultDurationMax )]]></AdditionalHelpText>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
            <Description><![CDATA[Enable Input - System Defined Parameter]]></Description>
          </Parameter>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
            <Description><![CDATA[Enable Output - System Defined Parameter]]></Description>
          </Parameter>
          <Parameter Name="Cfg_NumberOfFaults" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
            <Description><![CDATA[Number of faults to be generated (valid 1-64)
value 0 resets the F (output) bits]]></Description>
            <DefaultData Format="L5K"><![CDATA[1]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="1" />
            </DefaultData>
          </Parameter>
          <Parameter Name="Cfg_FaultOccurenceAll" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="None">
            <Description><![CDATA[Probability of ANY fault occurence (valid 0-1)]]></Description>
            <DefaultData Format="L5K"><![CDATA[5.00000000e-002]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="REAL" Radix="Float" Value="0.05" />
            </DefaultData>
          </Parameter>
          <Parameter Name="Cfg_FaultDurationMin" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
            <Description><![CDATA[Minimum duration of fault [seconds]]]></Description>
            <DefaultData Format="L5K"><![CDATA[15]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="15" />
            </DefaultData>
          </Parameter>
          <Parameter Name="Cfg_FaultDurationMax" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
            <Description><![CDATA[Maximum duration of fault [seconds]]]></Description>
            <DefaultData Format="L5K"><![CDATA[75]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="75" />
            </DefaultData>
          </Parameter>
          <Parameter Name="F" TagType="Base" DataType="LINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
            <Description><![CDATA[Generated fault bits]]></Description>
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="LINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="RandomNr" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
            <DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="REAL" Radix="Float" Value="0.0" />
            </DefaultData>
          </Parameter>
        </Parameters>
