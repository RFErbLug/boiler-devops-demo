        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[FLL(0,WRK[0],6);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[MVM(V1,2047,WRK[0])MVM(V2,2047,WRK[1])MUL(WRK[0],WRK[1],WRKm[0]);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[BTD(V1,11,WRK[2],0,11)BTD(V2,11,WRK[3],0,11)MUL(WRK[0],WRK[3],WRKm[1])MUL(WRK[1],WRK[2],WRKm[2]);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[BTD(V1,22,WRK[4],0,10)BTD(V2,22,WRK[5],0,10)MUL(WRK[2],WRK[3],WRKm[3])MUL(WRK[0],WRK[5],WRKm[4])MUL(WRK[1],WRK[4],WRKm[5]);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text><![CDATA[CLR(Out)MVM(WRKm[0],2047,Out);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text><![CDATA[CLR(Mid)BTD(WRKm[0],11,Mid,0,11);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text><![CDATA[ADD(Mid,WRKm[1],Mid)ADD(Mid,WRKm[2],Mid)BTD(Mid,0,Out,11,11);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text><![CDATA[CLR(High)BTD(Mid,11,High,0,11);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text><![CDATA[ADD(High,WRKm[3],High)ADD(High,WRKm[4],High)ADD(High,WRKm[5],High)BTD(High,0,Out,22,10);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text><![CDATA[XIC(High.11)OTE(Sts_C);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text><![CDATA[XIC(Out.31)OTE(Sts_N);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text><![CDATA[[XIC(Sts_N) ,GE(High,2048) ]OTE(Sts_V);]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text><![CDATA[XIO(Sts_C)EQ(Out,0)OTE(Sts_Z);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
      <AddOnInstructionDefinition Name="AOI_SIM_RNG_Simple" Class="Standard" Revision="1.3" Vendor="Dr. Frank Jordan / Rockwell Automation" ExecutePrescan="true" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-06-09T12:25:48.173Z" CreatedBy="WIN-FJASSBQU6AJ\RA" EditedDate="2013-10-18T11:25:49.197Z" EditedBy="RA-INT\RdeRijke" SoftwareRevision="v20.01">
        <Description><![CDATA[Simple Random Number Generator]]></Description>
        <RevisionNote><![CDATA[This code is provided as application example without any warranty]]></RevisionNote>
        <AdditionalHelpText><![CDATA[George Marsaglia 's MWC (multiply with carry) algorithm
(taken from http://www.codeproject.com/Articles/25172/Simple-Random-Number-Generation)]]></AdditionalHelpText>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
            <Description><![CDATA[Enable Input - System Defined Parameter]]></Description>
          </Parameter>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
            <Description><![CDATA[Enable Output - System Defined Parameter]]></Description>
          </Parameter>
          <Parameter Name="Seed" TagType="Alias" Usage="Input" Radix="Decimal" AliasFor="LocalSeed" Required="false" Visible="true" ExternalAccess="Read Only" />
          <Parameter Name="Count" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="Number" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
