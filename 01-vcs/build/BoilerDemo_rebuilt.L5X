    <Programs>
      <Program Name="BoilerDemoProgram" TestEdits="false" MainRoutineName="BoilerDemoRoutine" Disabled="false" Class="Standard" UseAsFolder="false">
        <Tags>
          <Tag Name="Count" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
            <Data Format="L5K"><![CDATA[5]]></Data>
            <Data Format="Decorated">
              <DataValue DataType="INT" Radix="Decimal" Value="5" />
            </Data>
          </Tag>
          <Tag Name="Direction" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
            <Data Format="L5K"><![CDATA[1]]></Data>
            <Data Format="Decorated">
              <DataValue DataType="BOOL" Radix="Decimal" Value="1" />
            </Data>
          </Tag>
          <Tag Name="Init" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
            <Data Format="L5K"><![CDATA[1]]></Data>
            <Data Format="Decorated">
              <DataValue DataType="BOOL" Radix="Decimal" Value="1" />
            </Data>
          </Tag>
        </Tags>
        <Routines>
          <Routine Name="BoilerDemoRoutine" Type="ST">
            <STContent>
              <Line Number="0"><![CDATA[//Init Motors and WaterTank]]></Line>
              <Line Number="1"><![CDATA[if (not Init) then]]></Line>
              <Line Number="2"><![CDATA[	Init := 1;]]></Line>
              <Line Number="3"><![CDATA[	Motors[0].SetSpeed := 100;]]></Line>
              <Line Number="4"><![CDATA[	Motors[1].SetSpeed := 120;]]></Line>
              <Line Number="5"><![CDATA[	Motors[2].SetSpeed := 140;]]></Line>
              <Line Number="6"><![CDATA[	Motors[3].SetSpeed := 160;]]></Line>
              <Line Number="7"><![CDATA[	Motors[4].SetSpeed := 180;]]></Line>
              <Line Number="8"><![CDATA[	Tank2.SetPoint := 50.0;]]></Line>
              <Line Number="9"><![CDATA[	Tank1.SetPoint := 50.0;]]></Line>
              <Line Number="10"><![CDATA[	Tank2.Level := 1;]]></Line>
              <Line Number="11"><![CDATA[	Tank1.Level := 1;]]></Line>
              <Line Number="12"><![CDATA[end_if;]]></Line>
              <Line Number="13"><![CDATA[]]></Line>
              <Line Number="14"><![CDATA[if (TestIncrementTag = 0) then]]></Line>
              <Line Number="15"><![CDATA[	Direction := 1;]]></Line>
              <Line Number="16"><![CDATA[end_if;]]></Line>
              <Line Number="17"><![CDATA[if (TestIncrementTag = 100) then]]></Line>
              <Line Number="18"><![CDATA[	Direction := 0;]]></Line>
              <Line Number="19"><![CDATA[end_if;]]></Line>
              <Line Number="20"><![CDATA[if (TestBoolTag) then]]></Line>
              <Line Number="21"><![CDATA[	if (Direction) then ]]></Line>
              <Line Number="22"><![CDATA[		TestIncrementTag := TestIncrementTag + 1;]]></Line>
              <Line Number="23"><![CDATA[	else]]></Line>
              <Line Number="24"><![CDATA[		TestIncrementTag := TestIncrementTag - 1;]]></Line>
              <Line Number="25"><![CDATA[	end_if;]]></Line>
              <Line Number="26"><![CDATA[end_if;]]></Line>
              <Line Number="27"><![CDATA[]]></Line>
              <Line Number="28"><![CDATA[]]></Line>
              <Line Number="29"><![CDATA[//Motor Logic]]></Line>
              <Line Number="30"><![CDATA[for Count := 0 to 4 do]]></Line>
              <Line Number="31"><![CDATA[	if (Motors[Count].CmdOffOn) then]]></Line>
              <Line Number="32"><![CDATA[		Motors[Count].Status := 1;]]></Line>
              <Line Number="33"><![CDATA[		if (Motors[Count].Speed <= Motors[Count].SetSpeed) then]]></Line>
              <Line Number="34"><![CDATA[			Motors[Count].Speed := Motors[Count].Speed + 1;]]></Line>
              <Line Number="35"><![CDATA[			Motors[Count].Power := Motors[Count].Power + 0.2;]]></Line>
              <Line Number="36"><![CDATA[		end_if;]]></Line>
              <Line Number="37"><![CDATA[	else]]></Line>
              <Line Number="38"><![CDATA[		Motors[Count].Status := 0;]]></Line>
              <Line Number="39"><![CDATA[		if (Motors[Count].Speed >= 0) then]]></Line>
              <Line Number="40"><![CDATA[			Motors[Count].Speed := Motors[Count].Speed - 1;]]></Line>
              <Line Number="41"><![CDATA[			Motors[Count].Power := Motors[Count].Power - 0.2;]]></Line>
              <Line Number="42"><![CDATA[		end_if;]]></Line>
              <Line Number="43"><![CDATA[	end_if;]]></Line>
              <Line Number="44"><![CDATA[end_for;]]></Line>
              <Line Number="45"><![CDATA[]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
