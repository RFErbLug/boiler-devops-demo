          <Routine Name="Tank1" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Tank1_ValveInCmd)LT(Tank1_Level,Tank1_SetPoint)OTE(Tank1_ValveInStatus);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Tank1_ValveOutCmd)GE(Tank1.Level,1)OTE(Tank1_ValveOutStatus);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Tank1_ValveInStatus)ADD(Tank1_Level,1,Tank1_Level);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[XIC(Tank1_ValveOutStatus)SUB(Tank1_Level,1,Tank1_Level);]]></Text>
              </Rung>
            </RLLContent>
