          <LocalTag Name="Cfg_CycleTime" DataType="REAL" Radix="Float" ExternalAccess="Read/Write">
            <Description><![CDATA[Fault generation cycle time [seconds]]]></Description>
            <DefaultData Format="L5K"><![CDATA[1.50000000e+000]]></DefaultData>
            <DefaultData Format="Decorated">
              <DataValue DataType="REAL" Radix="Float" Value="1.5" />
            </DefaultData>
          </LocalTag>
